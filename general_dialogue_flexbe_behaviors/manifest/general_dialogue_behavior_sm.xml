<?xml version="1.0" encoding="UTF-8"?>
<behavior name="General Dialogue Behavior">
    <executable package_path="general_dialogue_flexbe_behaviors.general_dialogue_behavior_sm" class="GeneralDialogueBehaviorSM" />
    <tagstring>dialogue, interaction, voice</tagstring>
    <author>agilex03</author>
    <date>2025/04/20</date>
    <description>
        通用对话系统行为状态机
        该行为封装了通用对话系统的完整功能，包括人脸检测、语音交互和动画显示。
    </description>
    <parameters>
        <parameter name="face_angle_topic" default="/face_angle" label="Face Angle Topic" type="text" />
        <parameter name="llm_response_topic" default="/llm_response" label="LLM Response Topic" type="text" />
        <parameter name="audio_complete_topic" default="/audio_playback_complete" label="Audio Complete Topic" type="text" />
        <parameter name="continue_detection_topic" default="/continue_detection" label="Continue Detection Topic" type="text" />
        <parameter name="active_questioning_service" default="/active_questioning/trigger_question" label="Active Questioning Service" type="text" />
        <parameter name="interaction_timeout" default="300.0" label="Interaction Timeout (s)" type="double" />
    </parameters>
</behavior>
